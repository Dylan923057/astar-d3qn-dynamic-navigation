__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.vscode/
.tmp_pdf/
%SystemDrive%/
relative articles/
outputs/*
!outputs/.gitkeep
# Frozen validation input required by the runtime-path entry; other run outputs stay local.
!outputs/foundation_dynamic_ratios_91701_20261002_v1/
outputs/foundation_dynamic_ratios_91701_20261002_v1/*
!outputs/foundation_dynamic_ratios_91701_20261002_v1/fixed_validation_scenarios.json
# Generated archives and bulk duplicate traces; keep reports, tables and selected examples.
/results/analysis_upload/*.zip
/results/analysis_upload/**/failure_trajectories.json
/transfer_packages/*.zip
/transfer_packages/**/outputs/
*.pth
*.pt
!results/paper_evidence/**/*.pth
!results/paper_evidence/**/*.pt
*.npz
!data/demonstrations/train_astar_demos.npz
# Repair runs retain full raw traces locally; publish audited reports and tables.
/results/whole_map_91701_value_repair_v1/**/validation_failures_*.json
/results/whole_map_91701_value_repair_v1/**/static_final_trace.json
# Bulk trajectory copies stay local; analysis packages retain selected full examples.
/results/whole_map_91701_training_handover_v1/**/final_failures_*.json
/results/whole_map_91701_value_repair_v1/**/navigation_examples_*.json
/results/whole_map_91701_value_repair_pilot_v1/**/navigation_examples_*.json
